{
  "name": "localscope",
  "version": "1.0.0",
  "private": true,
  "description": "LocalScope — Centralized Local SEO Platform Controller",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:all": "concurrently --kill-others --names \"FRONTEND,BACKEND\" --prefix-colors \"cyan,green\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "node scripts/start-backend.js",
    "install:all": "npm install && npm install --prefix frontend --legacy-peer-deps && pip install -r backend/requirements.txt",
    "build:frontend": "npm run build --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "tree-kill": "^1.2.2"
  }
}

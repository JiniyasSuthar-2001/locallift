# ==========================================
# LocalScope — Environment Configuration
# ==========================================

# Backend API Configuration
PROJECT_NAME=LocalScope
VERSION=1.0.0
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key
DATABASE_URL=sqlite+aiosqlite:///./localscope.db

# Frontend URL & CORS
FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Google Platform API Integrations (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/integrations/google/callback

# SERP / Rank Tracking Provider (Optional - SerpApi or Mock)
SERP_PROVIDER=serpapi
SERPAPI_KEY=

# AI Engine API Keys (Optional - Local Rule Engine works without API keys)
AI_API_KEY=
AI_MODEL=gemini-1.5-pro

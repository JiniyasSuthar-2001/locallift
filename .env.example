# ==========================================
# LocalLift — Environment Configuration
# ==========================================

# Application & Environment
ENVIRONMENT=development
PROJECT_NAME=LocalLift
VERSION=1.0.0
API_V1_STR=/api/v1

# Security Key (Generate a random 64-char hex key for production: openssl rand -hex 32)
# Required for production!
SECRET_KEY=replace-with-a-secure-random-secret-key-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (PostgreSQL in production, SQLite for local dev)
DATABASE_URL=sqlite+aiosqlite:///./locallift.db

# Frontend URL & CORS Origins
FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Google Platform Integrations (OAuth credentials from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/integrations/google/callback

# SERP / Rank Tracking Provider (Optional - SerpApi or Mock)
SERP_PROVIDER=mock
SERPAPI_KEY=your-serpapi-key

# AI Engine API Keys (Optional - Local rule engine works out of the box without external AI keys)
AI_PROVIDER=rule_based
AI_API_KEY=your-gemini-or-openai-key
AI_MODEL=gemini-1.5-flash

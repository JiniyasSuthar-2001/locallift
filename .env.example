# ==========================================
# LocalLift — Environment Configuration
# ==========================================

# Application & Environment
ENVIRONMENT=development
PROJECT_NAME=LocalLift
VERSION=1.0.0
API_V1_STR=/api/v1

# Security Key (Generate a random 64-char hex key for production: openssl rand -hex 32)
# Required for production!
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (PostgreSQL in production, SQLite for local dev)
DATABASE_URL=sqlite+aiosqlite:///./locallift.db

# Frontend URL & CORS Origins
FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Google Platform Integrations (OAuth credentials & Google Places API Key)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/integrations/google/callback
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_PLACES_API_KEY=

# SERP / Rank Tracking Provider (SerpApi default)
SERP_PROVIDER=serpapi
OPENSERP_BASE_URL=http://127.0.0.1:7000
OPENSERP_TIMEOUT=30
OPENSERP_DEFAULT_ENGINE=google
SERP_FALLBACK_PROVIDER=
SERPAPI_KEY=

# AI Engine API Keys (Supported AI Provider: Gemini)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
